# Copy to .env.local for local work, or add these in Vercel > Project > Settings > Environment Variables.
# Never commit real values. Every value below is intentionally empty.

# ---- Forms (required for /api/submit-form, /api/contact, /api/onboard-form) ----
RESEND_API_KEY=
# Where enquiries are delivered. Defaults to hello@onesimplesite.co.uk if empty.
ADMIN_EMAIL=
# Public origin of THIS deployment, no trailing slash. Used for redirects and the origin check.
SITE_URL=
# Optional comma-separated extra origins allowed to post (for example a staging URL).
ALLOWED_ORIGINS=

# ---- Stripe Checkout (all optional; checkout stays OFF unless every item is set) ----
CHECKOUT_ENABLED=
# Set to "true" only after the owner has signed off prices, VAT treatment and terms.
PRICING_APPROVED=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Set to "true" to allow an sk_live_ key. Without it a live key is refused.
STRIPE_ALLOW_LIVE=
# One Stripe Price per package, created in Stripe for the amount that package should charge now
# (Starter full price 19900p; Sorted and Works the 50% deposit 19950p / 32450p).
STRIPE_PRICE_STARTER=
STRIPE_PRICE_SORTED=
STRIPE_PRICE_WORKS=
# Set each to "true" only when that package is ready to be paid for online.
PACKAGE_READY_STARTER=
PACKAGE_READY_SORTED=
PACKAGE_READY_WORKS=
# Fulfilment idempotency store (Upstash Redis REST, e.g. via the Vercel Marketplace).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
