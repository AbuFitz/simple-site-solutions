# Copy to .env.local for local work, or add these in Vercel > Project > Settings > Environment Variables.
# Never commit real values. Every value below is intentionally empty.

# ---- Forms (required for /api/submit-form, /api/contact, /api/onboard-form) ----
RESEND_API_KEY=
# Where enquiries are delivered. Defaults to hello@onesimplesite.co.uk if empty.
ADMIN_EMAIL=
# Public origin of THIS deployment, no trailing slash. Used for redirects and the origin check.
SITE_URL=
# Optional comma-separated extra origins allowed to post (for example a staging URL).
ALLOWED_ORIGINS=

# ---- Stripe Checkout (all optional; checkout stays OFF unless every item is set) ----
CHECKOUT_ENABLED=
# Set to "true" only after the owner has signed off prices, VAT treatment and terms.
PRICING_APPROVED=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Set to "true" to allow an sk_live_ key. Without it a live key is refused.
STRIPE_ALLOW_LIVE=
# One Stripe Price per package, created in Stripe for the amount that package should charge now
# (Starter full price 19900p; Sorted and Works the 50% deposit 19950p / 32450p).
STRIPE_PRICE_STARTER=
STRIPE_PRICE_SORTED=
STRIPE_PRICE_WORKS=
# Set each to "true" only when that package is ready to be paid for online.
PACKAGE_READY_STARTER=
PACKAGE_READY_SORTED=
PACKAGE_READY_WORKS=
# Fulfilment idempotency store (Upstash Redis REST, e.g. via the Vercel Marketplace).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Shop (all optional; ordering stays CLOSED unless every gate is satisfied) ----
# Master switch for the shop. Also needs PRICING_APPROVED, STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET,
# SITE_URL, UPSTASH_REDIS_REST_URL/TOKEN and RESEND_API_KEY from above.
SHOP_ENABLED=
# Set to "true" only once a real production route exists for POSTED products (supplier confirmed,
# samples checked, dispatch process known). Digital products don't need it.
SHOP_FULFILMENT_CONFIRMED=
# Per variant (see docs/shop-launch.md for the full list). KEY = PRODUCT_SLUG_VARIANT in capitals, e.g. REVIEW_CARD_X5.
# SHOP_PRICE_<KEY>  a real one-time GBP Stripe Price id whose amount equals the catalogue price in src/data/shop.ts
# SHOP_READY_<KEY>  "true" when that variant can be made and sold
# SHOP_STOCK_<KEY>  optional whole number; 0 = sold out; empty = not tracked
# NFC + QR Review Card / 1 card (£14.99)
SHOP_PRICE_REVIEW_CARD_X1=
SHOP_READY_REVIEW_CARD_X1=
SHOP_STOCK_REVIEW_CARD_X1=
# NFC + QR Review Card / Pack of 5 (£59.00)
SHOP_PRICE_REVIEW_CARD_X5=
SHOP_READY_REVIEW_CARD_X5=
SHOP_STOCK_REVIEW_CARD_X5=
# NFC + QR Review Card / Pack of 10 (£99.00)
SHOP_PRICE_REVIEW_CARD_X10=
SHOP_READY_REVIEW_CARD_X10=
SHOP_STOCK_REVIEW_CARD_X10=
# Countertop Review Stand / 1 stand (£24.99)
SHOP_PRICE_REVIEW_STAND_X1=
SHOP_READY_REVIEW_STAND_X1=
SHOP_STOCK_REVIEW_STAND_X1=
# Countertop Review Stand / Set of 3 (£64.99)
SHOP_PRICE_REVIEW_STAND_X3=
SHOP_READY_REVIEW_STAND_X3=
SHOP_STOCK_REVIEW_STAND_X3=
# Review Kit / 1 stand + 1 card (£34.00)
SHOP_PRICE_REVIEW_KIT_S1C1=
SHOP_READY_REVIEW_KIT_S1C1=
SHOP_STOCK_REVIEW_KIT_S1C1=
# Review Kit / 1 stand + 5 cards (£79.00)
SHOP_PRICE_REVIEW_KIT_S1C5=
SHOP_READY_REVIEW_KIT_S1C5=
SHOP_STOCK_REVIEW_KIT_S1C5=
# Smart NFC + QR Business Card / 1 card (£19.99)
SHOP_PRICE_SMART_BUSINESS_CARD_X1=
SHOP_READY_SMART_BUSINESS_CARD_X1=
SHOP_STOCK_SMART_BUSINESS_CARD_X1=
# Smart NFC + QR Business Card / Pack of 3 (£49.99)
SHOP_PRICE_SMART_BUSINESS_CARD_X3=
SHOP_READY_SMART_BUSINESS_CARD_X3=
SHOP_STOCK_SMART_BUSINESS_CARD_X3=
# QR Table Sign / A6 stand (105 x 148 mm) (£15.99)
SHOP_PRICE_QR_TABLE_SIGN_A6=
SHOP_READY_QR_TABLE_SIGN_A6=
SHOP_STOCK_QR_TABLE_SIGN_A6=
# QR Table Sign / A5 stand (148 x 210 mm) (£21.99)
SHOP_PRICE_QR_TABLE_SIGN_A5=
SHOP_READY_QR_TABLE_SIGN_A5=
SHOP_STOCK_QR_TABLE_SIGN_A5=
# Window & Van QR Sticker Pack / Window pack: 4 x 100 mm (£14.99)
SHOP_PRICE_STICKER_PACK_WINDOW4=
SHOP_READY_STICKER_PACK_WINDOW4=
SHOP_STOCK_STICKER_PACK_WINDOW4=
# Window & Van QR Sticker Pack / Van pack: 2 x 200 mm (£24.99)
SHOP_PRICE_STICKER_PACK_VAN2=
SHOP_READY_STICKER_PACK_VAN2=
SHOP_STOCK_STICKER_PACK_VAN2=
# Digital QR Starter Pack / Up to 3 QR codes (£9.99)
SHOP_PRICE_DIGITAL_QR_PACK_PACK=
SHOP_READY_DIGITAL_QR_PACK_PACK=
SHOP_STOCK_DIGITAL_QR_PACK_PACK=
